# SkillNest Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# JSON Server base URL
# Local development — run: npm run server
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production — update after deploying JSON Server to Render
# NEXT_PUBLIC_API_URL=https://your-json-server.onrender.com

# BetterAuth — added in commit 11
# BETTER_AUTH_SECRET=generate-a-random-secret-here
# BETTER_AUTH_URL=http://localhost:3000
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/skillnest
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
